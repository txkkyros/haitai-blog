# 后台登录密码（本地和线上都要设）
ADMIN_PASSWORD=your-password

# 会话签名密钥，随便一串长随机字符
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SECRET=your-random-secret

# ---- 下面三个只在 Vercel 上需要 ----
# 不填则后台写本地文件；填了则后台把改动提交到 GitHub，由 Vercel 自动重新部署
GITHUB_TOKEN=
GITHUB_REPO=owner/repo-name
GITHUB_BRANCH=main
